# Written by ../infra/write-env.sh from `terraform output`. Auth is Entra ID only
# (DefaultAzureCredential, e.g. `az login` locally), so there are no API keys here.

# Azure AI Search service endpoint, e.g. https://<search-service>.search.windows.net
AZURE_SEARCH_ENDPOINT=
# Search index name; the backend creates it (default: docs)
AZURE_SEARCH_INDEX=docs
# Foundry (AIServices) account endpoint, e.g. https://<account>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=
# Chat model deployment name, e.g. gpt-4.1-mini
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Embedding model deployment name, e.g. text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Number of chunks retrieved per chat message and given to the model as sources (1-20, default: 5)
RAG_TOP_K=5

# --- Tracing (see docs/observability.md) ---
# Application Insights connection string. Leave empty to turn tracing off. Ingestion is keyless
# (Entra ID; local auth is off on the resource), so this only says where to send telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Record prompts and replies on spans (default: false). OK for the fictional sample handbook only.
GENAI_CAPTURE_CONTENT=false
# gen_ai.agent.id on every span, and the external agent's name in Foundry (default: basic-chatbot)
FOUNDRY_AGENT_NAME=basic-chatbot
# Foundry project endpoint, used only by `python -m app.register_agent`
# e.g. https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
