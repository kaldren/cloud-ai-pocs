# Written by ../infra/write-env.sh from `terraform output`. Auth is Entra ID only
# (DefaultAzureCredential, e.g. `az login` locally), so there are no API keys here.

# Azure AI Search service endpoint, e.g. https://<search-service>.search.windows.net
AZURE_SEARCH_ENDPOINT=
# Search index name; the backend creates it (default: docs)
AZURE_SEARCH_INDEX=docs
# Foundry (AIServices) account endpoint, e.g. https://<account>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=
# Chat model deployment name, e.g. gpt-4.1-mini
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Embedding model deployment name, e.g. text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
