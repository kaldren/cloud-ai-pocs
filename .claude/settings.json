{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(credentials*.json)",
      "Read(service-account*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
